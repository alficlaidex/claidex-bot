# Brand
BOT_NAME=Claide Bot by Alfi

# Authentication
AUTH_METHOD=auto
PAIRING_USE_CUSTOM_CODE=false
PAIRING_CUSTOM_CODE=
PAIRING_NUMBER=628123456789

# Owner numbers, comma-separated with country code and no symbols (DUMMY — ganti nomor asli)
OWNER_NUMBERS=628123456789

# Sticker metadata
STICKER_PACK_NAME=Made with
STICKER_AUTHOR=Alfi
STICKER_MAX_VIDEO_SECONDS=10

# Optional proxy: http, https, or socks5
PROXY_ENABLED=false
PROXY_TYPE=http
PROXY_HOST=
PROXY_PORT=0
PROXY_USERNAME=dummy-user
PROXY_PASSWORD=dummy-password

# Optional services (semua nilai di bawah DUMMY — isi dengan kredensial asli sendiri)
ORCA_API_URL=https://api.example.com/v1
ORCA_API_KEY=sk-dummy-orca-key
ORCA_MODEL=orca-mini
ORCA_VISION_MODEL=orca-vision
JINA_API_KEY=jina-dummy-key
DUCKAI_API_URL=https://duckduckgo.example.com/v1
DUCKAI_API_KEY=duck-dummy-key
DUCKAI_MODEL=duckchat-v1
FACESWAP_API_URL=https://faceswap.example.com
FACESWAP_API_KEY=faceswap-dummy-key
IG_DOWNLOADER_API_URL=https://igdl.example.com
IG_DOWNLOADER_API_KEY=igdl-dummy-key
WS_WORKER_URL=wss://audio.jhx.my.id/wss/audio
WS_PORT=8090
WS_PATH=/wss/audio

# Behavior
ANTI_SPAM_ENABLED=true
ANTI_SPAM_MAX=5
ANTI_SPAM_WINDOW_MS=10000
ANTI_SPAM_MUTE_MS=30000
COMMAND_COOLDOWN_MS=3000
AUTO_READ=true
TYPING_PRESENCE=true
HOT_RELOAD_ENABLED=false
HOT_RELOAD_DEBOUNCE_MS=400
HOT_RELOAD_NOTIFY_OWNER=true
REACT_CHANNEL_ENABLED=false
REACT_CHANNEL_URL=https://whatsapp.com/channel/0029VbCOLKRKrWQtIO1vzN0E
LOG_LEVEL=info
LIBRARY_LOG_LEVEL=error

# play2
PLAY2_THEME=aurora
PLAY2_VOICE_NOTE=on

# media WS (loopback + token by default)
MEDIA_WS_HOST=127.0.0.1
MEDIA_WS_TOKEN=dummy-local-token
MEDIA_WS_MAX_BYTES=100663296
